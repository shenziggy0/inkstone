{
  "name": "inkstone-editor",
  "version": "0.1.0",
  "private": true,
  "description": "墨页 — a local-first Markdown editor for macOS, Windows and Linux",
  "author": "Inkstone",
  "main": "electron/main.cjs",
  "desktopName": "inkstone.desktop",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "visual": "node test/visual-check.mjs",
    "package:mac": "npm run build && electron-builder --mac dir",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "appId": "app.inkstone.editor",
    "productName": "Inkstone",
    "icon": "build/icon.png",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "strictVerify": true,
      "timestamp": "none",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "backgroundColor": "#ffffff",
      "format": "UDZO",
      "window": {
        "width": 540,
        "height": 420
      },
      "contents": [
        {
          "x": 140,
          "y": 160,
          "type": "file",
          "name": "Inkstone.app"
        },
        {
          "x": 400,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 320,
          "type": "file",
          "path": "docs/install/macOS安装说明.txt",
          "name": "安装前请阅读 - Read Me.txt"
        }
      ]
    },
    "afterSign": "./scripts/verify-macos-ad-hoc.cjs",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "synopsis": "Local-first Markdown editor",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Inkstone",
          "Name[zh_CN]": "墨页"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "docs/install/windows-license.html"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6"
  }
}
